# Pocket console mode: the cage kiosk compositor on tty1 running a fullscreen terminal.
# Stage 55 appends the Pocket TUI command to the ExecStart line. Template pattern from the cage
# project docs (PAMName + TTYPath). Verify on the real display before relying on it.
[Unit]
Description=Pocket console mode (cage kiosk)
Conflicts=lightdm.service getty@tty1.service
After=systemd-user-sessions.service plymouth-quit-wait.service

[Service]
Type=simple
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -- /usr/bin/foot -f 'JetBrains Mono:size=14' -e tmux new -A -s pocket
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
