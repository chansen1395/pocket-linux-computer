# Restic settings for pocket-backup. Copy to /etc/pocket/restic.env (mode 0600) and fill in.
# Nothing here is a real repository: the backup timer does nothing until both values are set.
# Examples of a repository string: sftp:USER@HOST:/path/to/repo, rest:https://HOST:8000/, /mnt/usb/backups
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Or point at a file that holds the password instead of putting it here:
# RESTIC_PASSWORD_FILE=/etc/pocket/restic.password
BACKUP_PATHS="/home /data/notes /etc/pocket /etc/blocky"
BACKUP_EXCLUDES="--exclude-caches --exclude /home/*/.cache --exclude /home/*/.local/share/Trash"
